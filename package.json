{
  "name": "sentimeter",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "check-design": "bun test scripts/check-widget-design.test.ts scripts/check-site-design.test.ts && bun run scripts/check-widget-design.ts && bun run scripts/check-site-design.ts",
    "check-docs": "bun run scripts/check-docs.ts",
    "check-env": "bun run scripts/check-env.ts",
    "check-registry": "bun run --cwd apps/registry registry:check",
    "dev": "turbo run dev --filter=web",
    "dev:hosted": "turbo run dev dev:convex --filter=web",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "registry:emit": "bun run --cwd apps/registry registry:emit",
    "registry:build": "bun run --cwd apps/registry registry:build",
    "test": "turbo run test"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.15",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=20.9"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "web#build": {
      "dependsOn": ["^build"],
      "env": [
        "CLERK_JWT_ISSUER_DOMAIN",
        "CLERK_SECRET_KEY",
        "HOSTED_ANALYTICS",
        "WAITLIST_SECRET",
        "NODE_ENV",
        "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_CONVEX_URL",
        "NEXT_PUBLIC_CONVEX_SITE_URL"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "registry#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/widgets/src/**"],
      "outputs": ["public/r/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "registry#check-types": {
      "dependsOn": ["^check-types"],
      "outputs": ["worker-configuration.d.ts"]
    },
    "test": {
      "dependsOn": ["^test"],
      "passThroughEnv": ["SENTIMETER_POLISH_FIXTURES_DIR"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:convex": {
      "cache": false,
      "persistent": true
    }
  }
}

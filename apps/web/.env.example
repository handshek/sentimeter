# Optional unreleased hosted analytics in development.
# Copy this file to .env.local and replace these examples for hosted routes.
# Public registry pages and local widget completion need none of these values.
# Convex (from the dashboard or `bunx convex dev`)
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Clerk (from dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional waitlist: use the same private random secret in Next.js and Convex.
# Requires NEXT_PUBLIC_CONVEX_URL. Never prefix this secret with NEXT_PUBLIC_.
# WAITLIST_SECRET=

# Optional override for a future hosted launch; leave unset for registry launch.
# HOSTED_ANALYTICS=live

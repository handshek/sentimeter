# Copy to apps/web/.env.local only if you need one of the optional groups below.
# The public site (homepage, catalog, docs, previews, llms.txt) needs no
# variables at all: `bun run dev` works with an empty environment.

# ── Waitlist (optional) ─────────────────────────────────────────────────────
# Enables the /dashboard waitlist form. Use the same private random secret in
# Next.js and Convex. Never prefix this secret with NEXT_PUBLIC_.
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# WAITLIST_SECRET=

# ── Hosted analytics (unreleased, maintainers only) ─────────────────────────
# Opens the dashboard, sign-in/up and the /widgets lab. Requires every value
# below; then run `bun run dev:hosted` from the repository root.
# HOSTED_ANALYTICS=live

# Convex (from the dashboard or `bunx convex dev`)
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Clerk (from dashboard.clerk.com)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# Set in the Convex deployment, not here: CLERK_JWT_ISSUER_DOMAIN
